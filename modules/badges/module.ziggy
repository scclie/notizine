.{
    .name = "badges",
    .type = "static",
    .description = "88x31 badge buttons",
    .delivery = "critical",
    .assets = [
        .{ .source = "style.css", .delivery = "critical" },
        .{ .source = "badges.css", .delivery = "external", .output = "/badges/badges.css" },
    ],
    .params = .{
        .items = .{
            .type = "array",
            .items = .{
                .type = "object",
                .properties = .{
                    .href = .{ .type = "url", .required = true },
                    .src = .{ .type = "string", .required = true },
                    .alt = .{ .type = "string" },
                },
            },
            .default = [],
        },
    },
}
