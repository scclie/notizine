.{
    .name = "badges",
    .type = "static",
    .description = "88x31 badge buttons",
    // Badge images (base64) are in badges.css — loaded as a separate HTTP request.
    // This keeps the main inline <style> block smaller and lets the browser
    // cache badge images independently from the rest of the CSS.
    // Layout styles (flex, sizing, border) stay in style.css (inlined).
}
