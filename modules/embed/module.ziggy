.{
    .name = "embed",
    .type = "dynamic",
    .description = "Embed external content via iframe",
    .delivery = "critical",
    .assets = [
        .{ .source = "style.css", .delivery = "critical" },
    ],
    .params = .{
        .url = .{ .type = "url", .required = true },
        .height = .{ .type = "number" },
        .width = .{ .type = "number" },
        .title = .{ .type = "string" },
    },
}
