{
  "site": {
    "host_url": "https://example.com",
  "locales": [
    { "code": "en", "name": "English", "site_title": "notizine", "content_dir_path": "content/en", "output_prefix_override": "" }
  ]
  },
  "theme": "nord-default",

  // ── Features ──  Toggle site features on/off. false = removed from output.
  "features": {
    "recents": true,            // /recents/ - latest posts list
    "explorer": true,           // /explorer/ - full site tree
    "search": true,             // /search/ - client-side search page
    "darkmode": true,           // ☀/☾ theme toggle + prefers-color-scheme
    "translation_notice": false, // "auto-translated" banner on non-primary locale pages
    "tags": true,               // /tags/ - tag listing + JS filter
    "breadcrumbs": true,        // Home / Section / Page breadcrumb chain
    "og_images": true,          // 1200×630 PNG social preview images
    "rss": false,                // RSS feed + discovery link + footer button
    "inline_mode": true,        // Inline CSS into <style> (zero external CSS requests)
    "prev_next": false,         // Previous/Next post navigation in content
    "mermaid": false            // Render mermaid diagrams at build time (requires mermaid-cli)
  },

  // ── Performance ── Static HTML gzip audit policy.
  "performance": {
    "critical_html_gzip_budget": "14kb",
    "on_budget_exceeded": "warn"
  },
  "language_primary": "en",     // Primary locale for i18n defaults

  // ── Analytics & Comments ──
  "analytics": "",              // Raw analytics script/URL. Empty = disabled.
  "plausible_domain": "",       // Plausible domain (e.g. "example.com")
  "comments": {},               // Reserved for self-hosted comments (v3)

  // ── Module settings ──  Per-module customization.
  "modules": {
    "recents": {
      "count": 5                // Number of recent posts to show
    }
  },

  // ── Slots (module system) ──
  // Nine 3×3 grid cells, each an ordered list of ROWS. Modules in the same row
  // appear next to each other in a flex row. The page body is implicit in
  // middle_center; do not configure _content.
  //
  // Module entry fields:
  //   "module": module name (built-in start with _, custom use directory name)
  //   "align":  "left" | "center" | "right"  (default: "left")
  //   "section": section name for _recents / _explorer (e.g. "posts")
  //
  // Built-in modules: _header, _theme_toggle, _lang_nav, _spacer,
  //   _breadcrumbs, _recents, _explorer, _footer_text, _back_to_top
  //
  // Example: [{ "module": "_recents", "section": "posts", "show": ["date", "meta"] }]
  // Empty array [] = an empty grid cell.
  "slots": {
    "top_left": [],
    "top_center": [
      [{ "module": "divider" }],
      [{ "module": "_breadcrumbs" }]
    ],
    "top_right": [],
    // Left: site title + theme toggle above the documentation tree; Right: updates feed
    "middle_left": [
      [{ "module": "_header", "site_title": "notizine" },{ "module": "_theme_toggle" }],
      [{ "module": "_explorer", "root": "/notes/" }]
    ],
    "middle_center": [],
    "middle_right": [
      [{ "module": "_recents", "id": "_recents_updates", "section": "/updates/", "title": "Updates", "count": 3, "show": ["date"] }]
    ],
    "bottom_left": [],
    "bottom_center": [
      [{ "module": "divider" }],
      [{ "module": "badges", "align": "center" }],
      [{ "module": "_footer_text", "align": "center" }],
      [{ "module": "_rss_link", "align": "center" }],
      [{ "module": "_back_to_top", "align": "center" }]
    ],
    "bottom_right": []
  },

  // ── Layout ──
  "layout": {
    // Three-column, three-row CSS Grid tracks: left/center/right and top/middle/bottom.
    "columns": ["auto", "min(70vw, 55rem)", "auto"],
    "rows": ["auto", "1fr", "auto"],
    "gap": "1.5rem",             // Gap between grid tracks
    "width": "min(70vw, 55rem)",
    "spacing": 1,
    "left_width": "",            // Max width for left sidebar (e.g. "250px", "20vw"). Empty = no limit.
    "right_width": ""            // Max width for right sidebar (e.g. "250px", "20vw"). Empty = no limit.
  },

  "slots_overrides": {
    "/search/": {
      "top_left": [],
      "top_center": [],
      "top_right": [],
      "middle_left": [],
      "middle_center": [[{ "module": "search", "id": "search" }]],
      "middle_right": [],
      "bottom_left": [],
      "bottom_center": [],
      "bottom_right": []
    }
  },

  // ── Custom CSS ──
  "custom_css": "",             // Path to extra CSS file in assets/ (e.g. "css/custom.css")

  // ── Social ──
  "social": {
    "github": "",              // GitHub username (e.g. "torvalds") -- renders link to github.com/<username>
    "mastodon": ""             // Mastodon profile URL (e.g. "https://mastodon.social/@user")
  },

  // ── Fonts ──  CSS font-family values. Empty = system default.
  "fonts": {
    "heading": "",              // h1-h6, site title  -  e.g. "'Inter', sans-serif"
    "body": "",                 // body text  -  e.g. "'Inter', sans-serif"
    "code": ""                  // <code>, <pre>  -  e.g. "'JetBrains Mono', monospace"
  },
  "google_fonts": "",           // Google Fonts query: "Inter:wght@400;700"

  // ── OG Image generation ──  Generate 1200×630 PNG for social previews.
  "og": {
    "site_name": "notizine",    // Displayed at top-left of OG image. Use \n for multi-line.
    "font_family": "system-ui, sans-serif",  // Font family for OG image text
    // Colors - Nord palette defaults
    "bg_top": "#2e3440",        // Gradient top
    "bg_bottom": "#3b4252",     // Gradient bottom (or use background_image below)
    "accent": "#5e81ac",        // Left accent bar
    "text": "#eceff4",          // Title & description text
    "muted": "#b48ead",         // Date & site name text
    // Font sizes (px)
    "title_size": 52,           // Page title
    "desc_size": 26,            // Page description
    "site_size": 22,            // Site name
    "date_size": 24,            // Publication date
    // Toggles
    "show_date": true,          // Show publication date
    "show_desc": true,          // Show description text
    "background_image": ""      // Optional: image path/URL (overrides gradient)
  }
}
