{
  "site": {
    "host_url": "https://example.com",
  "locales": [
    { "code": "en", "name": "English", "site_title": "notizine", "content_dir_path": "content/en", "output_prefix_override": "" }
  ]
  },
  "theme": "nord-default",

  // ── features ── flip what u need false keeps it out of the build
  "features": {
    "recents": true,            // /recents/ - the latest posts
    "explorer": true,           // /explorer/ - the whole page tree
    "search": true,             // local search only loads where the widget is
    "darkmode": true,           // ☀/☾ toggle + ur system theme
    "translation_notice": false, // a heads up when a page is auto translated
    "tags": true,               // /tags/ - topics with a local js filter
    "breadcrumbs": true,        // home / section / page so u dont get lost
    "og_images": true,          // 1200×630 png previews for shared links
    "rss": false,               // feed + discovery link + optional footer link
    "inline_mode": true,        // css inside <style> instead of a separate request
    "prev_next": false,         // prev and next post links
    "mermaid": false            // build diagrams ahead of time needs mermaid-cli
  },

  // ── performance ── gzip budget for the html shell not the whole network load
  "performance": {
    "critical_html_gzip_budget": "14kb",
    "on_budget_exceeded": "warn"
  },
  "language_primary": "en",     // main language for i18n defaults

  // ── analytics and comments ──
  "analytics": "",              // analytics script or url leave empty to skip
  "plausible_domain": "",       // ur domain for plausible like "example.com"
  "comments": {},               // a spot for self-hosted comments later

  // ── module settings ── tweak each widget here
  "modules": {
    "recents": {
      "count": 5                // how many recent posts to show
    }
  },

  // ── slots ── the 3×3 thing
  // nine zones each with a list of rows
  // modules in the same row sit next to each other
  // the page body already lives in middle_center no _content module needed
  //
  // each module entry takes
  //   "module": its name built-ins start with _ custom ones use their folder name
  //   "align": "left" | "center" | "right" defaults to "left"
  //   "section": a section for _recents / _explorer like "posts"
  //
  // built-ins: _header, _theme_toggle, _lang_nav, _spacer,
  //   _breadcrumbs, _recents, _explorer, _footer_text, _back_to_top
  //
  // try [{ "module": "_recents", "section": "posts", "show": ["date", "meta"] }]
  // [] leaves a zone empty move modules around without editing templates
  "slots": {
    "top_left": [],
    "top_center": [[{ "module": "divider" }], [{ "module": "_breadcrumbs" }]],
    "top_right": [],
    "middle_left": [
      [{ "module": "_header", "site_title": "notizine" }, { "module": "_theme_toggle" }],
      [{ "module": "_explorer", "root": "/" }]
    ],
    "middle_center": [],
    "middle_right": [[{ "module": "_recents", "section": "/posts/", "title": "recent posts", "count": 5, "show": ["date"] }]],
    "bottom_left": [],
    "bottom_center": [[{ "module": "divider" }], [{ "module": "_footer_text", "align": "center", "text": "your site" }], [{ "module": "_back_to_top", "align": "center" }]],
    "bottom_right": []
  },

  // ── layout ──
  "layout": {
    // three columns left / center / right and three rows top / middle / bottom
    "columns": ["minmax(0, 1fr)", "minmax(0, 3fr)", "minmax(0, 1fr)"],
    "rows": ["auto", "1fr", "auto"],
    "gap": "1.5rem",             // space between zones
    "width": "55rem",
    "spacing": 1,
    "left_width": "",            // left sidebar cap like "250px" or "20vw" empty uses 300px
    "right_width": ""            // same for the right sidebar
  },

  "slots_overrides": {
    "/search/": {
      "top_left": [],
      "top_center": [[{ "module": "divider" }], [{ "module": "_breadcrumbs" }]],
      "top_right": [],
      "middle_left": [
        [{ "module": "_header", "site_title": "notizine" }, { "module": "_theme_toggle" }],
        [{ "module": "_explorer", "root": "/" }]
      ],
      "middle_center": [[{ "module": "search", "id": "search" }]],
      "middle_right": [[{ "module": "_recents", "section": "/posts/", "title": "recent posts", "count": 5, "show": ["date"] }]],
      "bottom_left": [],
      "bottom_center": [[{ "module": "divider" }], [{ "module": "_footer_text", "align": "center", "text": "your site" }], [{ "module": "_back_to_top", "align": "center" }]],
      "bottom_right": []
    }
  },

  // ── custom css ──
  "custom_css": "",             // extra styles inside assets/ like "css/custom.css"

  // ── social ──
  "social": {
    "github": "",              // ur handle like "torvalds" links to github.com/<username>
    "mastodon": ""             // profile url like "https://mastodon.social/@user"
  },

  // ── fonts ── css font-family values leave empty for system fonts
  "fonts": {
    "heading": "",              // headings and site title like "'Inter', sans-serif"
    "body": "",                 // body text same font-family format
    "code": ""                  // code blocks like "'JetBrains Mono', monospace"
  },
  "google_fonts": "",           // optional font query like "Inter:wght@400;700" adds remote requests

  // ── social previews ── 1200×630 png images made at build time
  "og": {
    "site_name": "notizine",    // top left of the preview use \n for more lines
    "font_family": "system-ui, sans-serif",  // font for the preview text
    // colors from the nord palette
    "bg_top": "#2e3440",        // top of the gradient
    "bg_bottom": "#3b4252",     // bottom or use an image below
    "accent": "#5e81ac",        // accent bar on the left
    "text": "#eceff4",          // title and description
    "muted": "#b48ead",         // date and site name
    // font sizes in px
    "title_size": 52,           // page title
    "desc_size": 26,            // description
    "site_size": 22,            // site name
    "date_size": 24,            // post date
    // flip these if u want
    "show_date": true,          // show the post date
    "show_desc": true,          // show the description
    "background_image": ""      // optional image path or url replaces the gradient
  }
}
