{
  "features": {
    "recents": true,
    "explorer": true,
    "search": true,
    "darkmode": true,
    "translation_notice": true,
    "tags": true,
    "breadcrumbs": true,
    "og_images": true,
    "rss": false,
    "inline_mode": true
  },
  "language_primary": "ru",
  "analytics": "",
  "plausible_domain": "",
  "comments": {},
  "slots": {
    "header": [
      ["_header"],
      ["_theme_toggle", "_spacer", "_lang_nav"]
    ],
    "before_main": [
      ["_breadcrumbs"]
    ],
    "left": [
      ["divider"],
      ["_recents"]
    ],
    "right": [],
    "after_main": [
      ["_prev_next"]
    ],
    "footer": [
      ["badges:center"],
      ["_footer_text:center"],
      ["_back_to_top"]
    ]
  },
  "layout": {
    "columns": ["auto", "720px", "auto"],
    "gap": "1.5rem"
  },
  "custom_css": "",
  "social": {
    "github": "",
    "mastodon": ""
  },
  "fonts": {
    "heading": "",
    "body": "",
    "code": ""
  },
  "google_fonts": "",
  "og": {
    "site_name": "notizine",
    "font_source": "google",
    "font_family": "Open+Sans:wght@400;700",
    "font_path": "",
    "bg_top": "#2e3440",
    "bg_bottom": "#3b4252",
    "accent": "#5e81ac",
    "text": "#eceff4",
    "muted": "#b48ead",
    "title_size": 52,
    "desc_size": 26,
    "site_size": 22,
    "date_size": 24,
    "show_date": true,
    "show_desc": true
  }
}
