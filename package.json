{
  "name": "notizine",
  "version": "0.1.0",
  "description": "Multilingual Zine-based generator for digital gardens and blogs",
  "private": true,
  "scripts": {
    "dev": "zine",
    "build": "bash scripts/build.sh",
    "build:fast": "zine release --force",
    "build:purge": "python3 scripts/purge-css.py public/index.html --in-place",
    "preview": "zine release --force && npx serve public"
  }
}
